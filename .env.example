VOLVO_CLIENT_ID=
VOLVO_CLIENT_SECRET=
VOLVO_API_KEY=
# Optional bei genau einem Fahrzeug im Volvo-Konto.
VOLVO_VIN=
VOLVO_REDIRECT_URI=http://localhost:8080/callback

MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# Optional: CA-Zertifikat im Container, z.B. /certs/ca.crt.
MQTT_CA_CERT=
# Muss bei mehreren Instanzen eindeutig sein.
MQTT_CLIENT_ID=volvo-ex30
MQTT_TOPIC_PREFIX=volvo

# Zwei Fahrzeugabfragen pro Intervall; zusaetzlich Token-Refresh und VIN-Ermittlung.
POLL_INTERVAL_SECONDS=300
LOG_LEVEL=INFO

# Read-only Dashboard im Bridge-Betrieb unter http://localhost:8080/
DASHBOARD_ENABLED=true
